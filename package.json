{
    "name": "fleet-ops-gym",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Browser-based RL environment for satellite fleet operations, built on jax-js",
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "typecheck": "tsc -p .",
        "train": "tsx src/rl/train.ts",
        "test": "tsx --test src/sim/sim.test.ts src/jax/parity.test.ts src/rl/ppo.test.ts",
        "test:sim": "tsx --test src/sim/sim.test.ts",
        "baselines": "tsx src/sim/run.ts",
        "bench": "tsx src/jax/bench.ts"
    },
    "dependencies": {
        "@jax-js/jax": "^0.1.27",
        "@jax-js/optax": "^0.1.3"
    },
    "devDependencies": {
        "@fontsource-variable/archivo": "^5.3.0",
        "@types/node": "^26.6.6",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2",
        "vite": "^8.3.5"
    }
}